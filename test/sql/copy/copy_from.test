# COPY ... FROM bulk-load test for the MongoDB extension.
#
# COPY <collection> FROM <file> binds to a LogicalInsert against the target
# collection, so it flows through the same MongoInsertOperator / insert_many path
# as INSERT.

require mongo

require-env MONGODB_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'host=localhost port=27017 dbname=duckdb_mongo_test' AS m (TYPE MONGO);

# Reset target for idempotent re-runs
statement ok
DROP TABLE IF EXISTS m.duckdb_mongo_test.copy_target;

statement ok
CREATE TABLE m.duckdb_mongo_test.copy_target AS
SELECT * FROM (VALUES (0, 'schema')) AS t(_id, name);

# Create a CSV to bulk-load
statement ok
COPY (SELECT * FROM (VALUES (100, 'cf1'), (101, 'cf2')) AS t(_id, name))
TO '__TEST_DIR__/copy_from.csv' (HEADER);

statement ok
COPY m.duckdb_mongo_test.copy_target FROM '__TEST_DIR__/copy_from.csv' (HEADER);

query IT
SELECT _id, name FROM m.duckdb_mongo_test.copy_target WHERE _id >= 100 ORDER BY _id;
----
100	cf1
101	cf2

statement ok
DETACH m;
